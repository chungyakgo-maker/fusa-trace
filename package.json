{
  "name": "fusa-trace",
  "productName": "FuSa Trace",
  "version": "0.3.0",
  "private": true,
  "description": "기능안전 추적성·산출물 관리 (오프라인 Windows 앱)",
  "author": "FuSa Trace",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fixtures": "node scripts/make-fixtures.mjs",
    "pretest": "node scripts/make-fixtures.mjs",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "smoke": "node tests/smoke/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "saxes": "^6.0.0",
    "xlsx": "0.18.5"
  }
